SELECT step_id, sub_equip_id, param_name, value, glass_start_time
FROM (
    SELECT
        B.step_id,
        B.sub_equip_id,
        B.value,
        B.glass_start_time,
        B.param_name,
        ROW_NUMBER() OVER(
            PARTITION BY B.sub_equip_id
